# Import into Portainer, then replace the values there.
# Only the host that keeps the backups needs this stack.

# Where the repository lives. Prefer a different disk than the one holding the
# data being backed up, and ideally one that is copied onward from there.
BACKUP_REPO_PATH=/path/to/repository

# The same repository and key the clients use, so the check can open it.
BACKUP_REPOSITORY=rest:http://user:password@127.0.0.1:8200/user/
BACKUP_PASSWORD=the-same-key-the-clients-use

# Push URL of a monitor that expects to hear from the check on a schedule.
BACKUP_CHECK_PING=http://uptime-kuma:3001/api/push/change-me
