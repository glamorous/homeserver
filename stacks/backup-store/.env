# Non-secret defaults, read automatically by Compose.
TZ="Europe/Brussels"

RESTIC_REST_PORT=8200

# --private-repos keeps every client to its own path under the repository.
# Deliberately not --append-only: that would also stop the clients pruning, and
# a repository that can never forget grows without end.
RESTIC_REST_OPTIONS=--private-repos

# Weekly. A plain check verifies the structure; reading a slice of the actual
# pack files is what catches a disk quietly corrupting data underneath it.
BACKUP_CHECK_CRON=0 0 5 * * 0
BACKUP_CHECK_ARGS=--read-data-subset=5%
