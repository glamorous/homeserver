# Import into Portainer, then replace the values there.
#
# Every entry is <url>|<admin password>. The primary is the Pi-hole you edit;
# replicas are overwritten with its configuration, so make sure the primary is
# the one holding the settings you want to keep.
#
# The local Pi-hole can be addressed by container name over the shared network.
NEBULA_SYNC_PRIMARY=http://pihole:80|change-me
# Comma-separated. Reach a Pi-hole on another host by address and published port.
NEBULA_SYNC_REPLICAS=https://other-host:444|change-me
