# Non-secret defaults, read automatically by Compose.
TZ="Europe/Brussels"

# Hourly is ample: this copies configuration, which you change by hand, not
# query data.
NEBULA_SYNC_CRON="0 * * * *"

# Copy the whole Teleporter export rather than selected sections.
NEBULA_SYNC_FULL=true

# Rebuild the replica's blocklist after a sync, otherwise a newly added adlist
# is present in its configuration but not yet in what it actually blocks.
NEBULA_SYNC_GRAVITY=true

# A Pi-hole reached over HTTPS serves its own self-signed certificate, which no
# CA vouches for. Only set this false when every replica is reached over plain
# HTTP on a trusted network.
NEBULA_SYNC_SKIP_TLS=true
