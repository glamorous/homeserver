# Import into Portainer, then replace the values there.
BASE_DIR=/path/to/docker-data

# Generate with: openssl rand -base64 60
# Losing this makes every stored credential and token unreadable. It is not a
# password you can simply change later.
AUTHENTIK_SECRET_KEY=generate-me

# Generate with: openssl rand -base64 36
# Read once, when the database is created. Changing it afterwards means
# changing it inside PostgreSQL too.
AUTHENTIK_PG_PASS=generate-me
