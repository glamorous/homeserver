# Import into Portainer, then replace the values there.
BASE_DIR=/path/to/docker-data

# Where Transmission writes, finished or not. Keep it outside BASE_DIR, or the
# backup copies half-downloaded files, and off the library disk.
MEDIA_DOWNLOADS_DIR=/path/to/downloads

# The folder that holds the libraries Plex reads, one subfolder per library.
MEDIA_LIBRARY_DIR=/path/to/media

# Plex: Settings -> a library item -> Get Info -> View XML, the X-Plex-Token in
# the URL. TMDb: themoviedb.org -> Settings -> API, the v3 key.
KOMETA_PLEX_TOKEN=paste-me
KOMETA_TMDB_KEY=paste-me
