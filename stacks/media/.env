# Non-secret defaults, read automatically by Compose.
TZ="Europe/Brussels"
PUID=1000
PGID=1000

# Published on the host and forwarded by the router: peers must reach it from
# outside. Transmission is told the same number so it never picks a random one.
TRANSMISSION_PEER_PORT=51413

# When Kometa updates Plex, comma-separated HH:MM.
KOMETA_TIMES=06:00

# How long the curator keeps looking for a better release. The later of the two
# deadlines wins, so a brand new film still gets the full release window.
CURATOR_DAYS_AFTER_ADD=14
CURATOR_DAYS_AFTER_RELEASE=90
