# Import into Portainer, then replace the values there.
BASE_DIR=/path/to/docker-data

# Name this host, so a snapshot says where it came from.
HOST_NAME=this-host

# rest:http://<user>:<password>@<store-host>:<port>/
BACKUP_REPOSITORY=rest:http://user:password@store.example.com:8200/

# Generate with: openssl rand -base64 32
# This encrypts the repository. Without it the backups are unreadable, so keep
# a copy somewhere that does not depend on the machines being backed up.
BACKUP_PASSWORD=generate-me
