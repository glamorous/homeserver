# Non-secret defaults, read automatically by Compose.
TZ="Europe/Brussels"

# Nightly, offset per host so two machines never write at the same moment.
BACKUP_CRON=0 30 3 * * *

# What is worth keeping. Snapshots are deduplicated, so a long tail is cheap.
BACKUP_RETENTION=--keep-daily 7 --keep-weekly 5 --keep-monthly 12 --prune
