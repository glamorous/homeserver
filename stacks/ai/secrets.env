# Import into Portainer, then replace the values there.
BASE_DIR=/path/to/docker-data
# Generate with: openssl rand -hex 32
WEBUI_SECRET_KEY=generate-me

# Sign-in through an identity provider. The account is keyed on the email
# address, so a person without one needs an internal address that never has to
# receive mail.
OPEN_WEBUI_URL=https://chat.example.com
OPEN_WEBUI_OIDC_DISCOVERY=https://auth.example.com/application/o/<slug>/.well-known/openid-configuration
OPEN_WEBUI_OAUTH_CLIENT_ID=from-your-provider
OPEN_WEBUI_OAUTH_CLIENT_SECRET=from-your-provider
