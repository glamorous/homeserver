# Import into Portainer, then replace the values there.
BASE_DIR=/path/to/docker-data
ADMIN_EMAIL=you@example.com
# Generate with: echo -n "base64:"; openssl rand -base64 32
SPEEDTEST_TRACKER_APP_KEY=base64:generate-me
SPEEDTEST_TRACKER_PASSWORD=change-me
SPEEDTEST_TRACKER_URL=https://speedtest.example.com
DIUN_TELEGRAM_TOKEN=your-bot-token
DIUN_TELEGRAM_CHATID=your-chat-id
