# General
TZ="Europe/Brussels"
PUID=1000
PGID=1000
LOCAL_USER=${PUID}

# Heimdall
HEIMDALL_PORT_HTTP=8080
HEIMDALL_PORT_HTTPS=4443

# Pi-hole
PIHOLE_PORT_HTTP=88
PIHOLE_PORT_HTTPS=444
PIHOLE_DNS_="1.1.1.2;1.0.0.2;9.9.9.9"

# InfluxDB
INFLUXDB_PORT=8086

# Node-Red
NODE_RED_PORT=1880

# Diun
DIUN_SCHEDULER="0 2 * * 6"

# Backup
BACKUP_SCHEDULER="*/5 * * * *"

# Nginx Proxy Manager
NGINX_PROXY_MANAGER_PORT_HTTP=80
NGINX_PROXY_MANAGER_PORT_HTTPS=443
NGINX_PROXY_MANAGER_PORT_ADMIN=81

# Uptime Kuma
UPTIME_KUMA_PORT=3001

# Speedtest tracker
SPEEDTEST_TRACKER_PORT_HTTP=8888
SPEEDTEST_TRACKER_PORT_HTTPS=8443
SPEEDTEST_TRACKER_SCHEDULE="6 */2 * * *"
SPEEDTEST_SERVERS="5151,69735,40400,15212"
