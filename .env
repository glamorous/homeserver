# General
TZ="Europe/Brussels"
PUID=1000
PGID=1000
LOCAL_USER=${PUID}

# Heimdall
HEIMDALL_PORT_HTTP=80
HEIMDALL_PORT_HTTPS=443

# Pi-hole
PIHOLE_PORT_HTTP=88
PIHOLE_PORT_HTTPS=444
PIHOLE_DNS_="1.1.1.2;1.0.0.2;9.9.9.9"

# InfluxDB
INFLUXDB_PORT=8086

# Node-Red
NODE_RED_PORT=1880

# Diun
DIUN_SCHEDULER="0 2 * * 6"

# Rclone
RCLONE_SCHEDULER="* * * * *"
