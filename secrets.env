BASE_DIR="/my-computer/my-folder/docker-data"

# Pihole
PIHOLE_ADMIN_PASSWORD=MY_PASSWORD

# DuckDNS
DUCKDNS_SUBDOMAINS=MY_DOMAIN,MY_SECOND_DOMAIN
DUCKDNS_TOKEN=MY_TOKEN

# Diun
DIUN_TELEGRAM_TOKEN=MY_TELEGRAM_TOKEN
DIUN_TELEGRAM_CHATID=MY_TELEGRAM_CHATID

# Backup
BACKUP_SOURCE="/my-computer/my-folder/source"
BACKUP_TARGET="/my-computer/my-folder/target"
